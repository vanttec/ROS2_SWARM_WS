<?xml version='1.0'?>
<!--
  Holybro X500 V2 airframe, sized and weighed to match the four aircraft in README.md.

    wheelbase        500 mm motor to motor (so 0.1768 m per axis in an X frame)
    props            1045, 10 in / 0.254 m diameter
    all-up weight    2.02 kg: frame + Pixhawk 6C + F9P + ESP8266 + 4S 5000 mAh
    inertia          0.022 / 0.022 / 0.040 kg m2 summed over all links
    thrust           43 N at full throttle, so thrust to weight 2.2

  The numbers above are what the flight dynamics depend on, and every collision and inertia
  here is a primitive sized to them. Only the VISUALS are meshes: frame, motors and 1045-class
  props from PX4's x500_base model, fetched from Gazebo Fuel (version 1, CC0) and cached in
  ~/.gz/fuel the first time a world loads, so the first start needs internet. That frame is
  NXP's HoverGames X500-class kit, not Holybro's own CAD, but it is the same 500 mm carbon X
  layout. Swapping a visual never changes how the copter flies.
-->
<sdf version='1.9'>
  <model name='x500_v2'>
    <pose>0 0 0 0 0 0</pose>

    <link name='base_link'>
      <velocity_decay>
        <linear>0.0</linear>
        <angular>0.0</angular>
      </velocity_decay>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <!--
          Mass and inertia of everything except the rotors and the IMU link, which Gazebo adds
          on top: 1.85 + 0.15 + 4 x 0.016 = 2.02 kg, and the rotors at 0.25 m bring the summed
          inertia to roughly 0.022 / 0.022 / 0.040.
        -->
        <mass>1.85</mass>
        <inertia>
          <ixx>0.018</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.018</iyy>
          <iyz>0</iyz>
          <izz>0.032</izz>
        </inertia>
      </inertial>

      <collision name='base_collision'>
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.19 0.19 0.08</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name='leg_0_collision'>
        <pose>0.11 0.11 -0.1135 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.227</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name='leg_1_collision'>
        <pose>0.11 -0.11 -0.1135 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.227</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name='leg_2_collision'>
        <pose>-0.11 0.11 -0.1135 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.227</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name='leg_3_collision'>
        <pose>-0.11 -0.11 -0.1135 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.227</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <!-- PX4 x500_base meshes, positioned as in its model.sdf. Visual only. -->
      <visual name='frame_visual'>
        <pose>0 0 0.025 0 0 3.141592654</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/NXP-HGD-CF.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name='motor_base_0_visual'>
        <pose>0.1768 -0.1768 0.032 0 0 -0.45</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/5010Base.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name='motor_base_1_visual'>
        <pose>-0.1768 0.1768 0.032 0 0 -0.45</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/5010Base.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name='motor_base_2_visual'>
        <pose>0.1768 0.1768 0.032 0 0 -0.45</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/5010Base.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name='motor_base_3_visual'>
        <pose>-0.1768 -0.1768 0.032 0 0 -0.45</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/5010Base.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Pixhawk 6C, 84 x 44 x 12 mm, on the frame's top plate (about 0.05 m up). -->
      <visual name='pixhawk_visual'>
        <pose>0 0 0.056 0 0 0</pose>
        <geometry>
          <box>
            <size>0.084 0.044 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.22 1</ambient>
          <diffuse>0.3 0.3 0.33 1</diffuse>
        </material>
      </visual>
      <visual name='battery_visual'>
        <pose>0 0 -0.035 0 0 0</pose>
        <geometry>
          <box>
            <size>0.15 0.06 0.045</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <link name='imu_link'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00002</iyy>
          <iyz>0</iyz>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <!-- ArduPilot wants the IMU in forward-right-down, so flip it about x. -->
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>
    <joint name='imu_joint' type='revolute'>
      <child>imu_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
        <dynamics>
          <damping>1.0</damping>
        </dynamics>
      </axis>
    </joint>
    <link name='rotor_0'>
      <pose>0.1768 -0.1768 0.045 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <!-- 1045 prop, 16 g, treated as a thin rod of length 0.254 m -->
        <mass>0.016</mass>
        <inertia>
          <ixx>1.0e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>8.5e-05</iyy>
          <iyz>0</iyz>
          <izz>9.0e-05</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='prop_visual'>
        <pose>-0.022 -0.14638461538461536 -0.001 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.8461538461538461 0.8461538461538461 0.8461538461538461</scale>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/1345_prop_ccw.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name='bell_visual'>
        <pose>0 0 -0.017 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/5010Bell.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name='rotor_0_joint' type='revolute'>
      <child>rotor_0</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>
    <link name='rotor_1'>
      <pose>-0.1768 0.1768 0.045 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <!-- 1045 prop, 16 g, treated as a thin rod of length 0.254 m -->
        <mass>0.016</mass>
        <inertia>
          <ixx>1.0e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>8.5e-05</iyy>
          <iyz>0</iyz>
          <izz>9.0e-05</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='prop_visual'>
        <pose>-0.022 -0.14638461538461536 -0.001 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.8461538461538461 0.8461538461538461 0.8461538461538461</scale>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/1345_prop_ccw.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name='bell_visual'>
        <pose>0 0 -0.017 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/5010Bell.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name='rotor_1_joint' type='revolute'>
      <child>rotor_1</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>
    <link name='rotor_2'>
      <pose>0.1768 0.1768 0.045 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <!-- 1045 prop, 16 g, treated as a thin rod of length 0.254 m -->
        <mass>0.016</mass>
        <inertia>
          <ixx>1.0e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>8.5e-05</iyy>
          <iyz>0</iyz>
          <izz>9.0e-05</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='prop_visual'>
        <pose>-0.022 -0.14638461538461536 -0.001 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.8461538461538461 0.8461538461538461 0.8461538461538461</scale>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/1345_prop_cw.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name='bell_visual'>
        <pose>0 0 -0.017 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/5010Bell.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name='rotor_2_joint' type='revolute'>
      <child>rotor_2</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>
    <link name='rotor_3'>
      <pose>-0.1768 -0.1768 0.045 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <!-- 1045 prop, 16 g, treated as a thin rod of length 0.254 m -->
        <mass>0.016</mass>
        <inertia>
          <ixx>1.0e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>8.5e-05</iyy>
          <iyz>0</iyz>
          <izz>9.0e-05</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.127</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='prop_visual'>
        <pose>-0.022 -0.14638461538461536 -0.001 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.8461538461538461 0.8461538461538461 0.8461538461538461</scale>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/1345_prop_cw.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <visual name='bell_visual'>
        <pose>0 0 -0.017 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/PX4/models/x500_base/1/files/meshes/5010Bell.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name='rotor_3_joint' type='revolute'>
      <child>rotor_3</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
      </axis>
    </joint>
  </model>
</sdf>
