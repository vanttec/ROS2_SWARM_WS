<?xml version='1.0'?>
<!--
  Holybro X500 V2 airframe, sized and weighed to match the four aircraft in README.md.

    wheelbase        500 mm motor to motor (so 0.1768 m per axis in an X frame)
    props            1045, 10 in / 0.254 m diameter
    all-up weight    2.02 kg: frame + Pixhawk 6C + F9P + ESP8266 + 4S 5000 mAh
    inertia          0.022 / 0.022 / 0.040 kg m2 summed over all links
    thrust           43 N at full throttle, so thrust to weight 2.2

  Geometry is primitives rather than meshes: nothing to download, and the numbers above are
  what the flight dynamics actually depend on. Swap the visuals for Holybro's meshes if you
  want it to look right in screenshots.
-->
<sdf version='1.9'>
  <model name='x500_v2'>
    <pose>0 0 0 0 0 0</pose>

    <link name='base_link'>
      <velocity_decay>
        <linear>0.0</linear>
        <angular>0.0</angular>
      </velocity_decay>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <!--
          Mass and inertia of everything except the rotors and the IMU link, which Gazebo adds
          on top: 1.85 + 0.15 + 4 x 0.016 = 2.02 kg, and the rotors at 0.25 m bring the summed
          inertia to roughly 0.022 / 0.022 / 0.040.
        -->
        <mass>1.85</mass>
        <inertia>
          <ixx>0.018</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.018</iyy>
          <iyz>0</iyz>
          <izz>0.032</izz>
        </inertia>
      </inertial>

      <collision name='base_collision'>
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>0.19 0.19 0.08</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name='leg_0_collision'>
        <pose>0.11 0.11 -0.085 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.17</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <max_vel>100.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name='leg_1_collision'>
        <pose>0.11 -0.11 -0.085 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.17</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
