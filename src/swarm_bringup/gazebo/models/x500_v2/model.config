<?xml version="1.0"?>
<model>
  <name>Holybro X500 V2</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <maintainer email="ricardocango2007@gmail.com">VANTTEC SWARM</maintainer>

  <description>
    Holybro X500 V2 airframe: 500 mm wheelbase quad X, 2216 KV880 motors, 1045 props,
    Pixhawk 6C + F9P + 4S 5000 mAh, 2.0 kg all-up weight.

    Airframe only - no autopilot plugin. The ArduPilotPlugin, LiftDrag and ApplyJointForce
    blocks live in the wrapper models inside the world, so each of the four SITL instances
    can have its own FDM port. See gazebo/tools/gen_x500_world.py.
  </description>
</model>
